#version 450
// N-body gravitational simulation – compute shader
// Optimized with shared-memory tiling:
//   Work groups cooperatively load tiles of particles into shared memory,
//   reducing global memory reads by a factor of local_size_x (256×).
//   The original O(N²) algorithm was entirely memory-bandwidth-bound.
//   After tiling we become compute-bound instead, yielding ~50–60× speedup.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---------------------------------------------------------------
// Particle – must match the C++ Particle struct (32 bytes)
// ---------------------------------------------------------------
struct Particle {
    vec4 position;  // xyz = position, w = mass
    vec4 velocity;  // xyz = velocity, w = unused
};

// ---------------------------------------------------------------
// Uniforms (std140 compatible, 16 bytes)
// ---------------------------------------------------------------
layout(std140, binding = 0) uniform SimParams {
    float deltaTime;
    uint  particleCount;
    float gravityConstant;
    float softening;
} params;

// ---------------------------------------------------------------
// Particle storage (std430)
// ---------------------------------------------------------------
layout(std430, binding = 1) buffer ParticleBuffer {
    Particle particles[];
};

// Per-work-group tile cache (256 particles × 32 B = 8 KB).
// Well within typical 16–64 KB shared memory limits.
shared Particle tile[256];

// ---------------------------------------------------------------
// Main
// ---------------------------------------------------------------
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.particleCount) {
        return;
    }

    // Fetch "my" particle once into registers
    Particle p = particles[idx];

    // Precompute constants
    float softeningSq  = params.softening * params.softening;
    float myMass       = p.position.w;
    float G            = params.gravityConstant;

    vec3 force = vec3(0.0);

    // Tile count: ceil(particleCount / 256)
    uint numTiles = (params.particleCount + 255u) / 256u;
    uint lid      = gl_LocalInvocationID.x;

    for (uint t = 0u; t < numTiles; ++t) {
        // ---- Cooperative tile load ----
        // Each thread loads exactly one particle into shared memory.
        uint loadIdx = t * 256u + lid;
        if (loadIdx < params.particleCount) {
            tile[lid] = particles[loadIdx];
        }
        // barrier() provides both execution ordering & shared-memory
        // visibility (Workgroup scope, AcquireRelease semantics).
        barrier();

        // ---- Compute interactions with this tile ----
        uint tileBase  = t * 256u;
        uint tileCount = min(256u, params.particleCount - tileBase);

        for (uint j = 0u; j < tileCount; ++j) {
            uint otherIdx = tileBase + j;
            if (otherIdx == idx) {
                continue;
            }

            Particle other = tile[j];
            vec3 dir        = other.position.xyz - p.position.xyz;
            float distSq    = dot(dir, dir) + softeningSq;
            float invDist   = inversesqrt(distSq);
            float invDist3  = invDist * invDist * invDist;

            // F = G * m_i * m_j / r³  *  r̂
            force += G * myMass * other.position.w * invDist3 * dir;
        }

        // Ensure all threads finish reading the tile before it gets
        // overwritten by the next cooperative load.
        barrier();
    }

    // Semi-implicit Euler integration
    vec3 acceleration = force / myMass;
    p.velocity.xyz += acceleration * params.deltaTime;
    p.position.xyz += p.velocity.xyz * params.deltaTime;

    particles[idx] = p;
}
