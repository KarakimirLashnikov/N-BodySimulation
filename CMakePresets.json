{
    "version": 8,
    "configurePresets": [
        {
            "name": "base",
            "displayName": "Visual Studio Community 2026 Release - amd64",
            "description": "将编译器用于 Visual Studio 18 2026 (x64 体系结构)",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "environment": {
                "CFLAGS": "/fsanitize=address",
                "CXXFLAGS": "/fsanitize=address /fsanitize=thread"
            }
        }
    ]
}